  <script>
    const userData = [
      { name: "A", age: 20, isActive: true },
      { name: "B", age: 17, isActive: true },
      { name: "C", age: 25, isActive: false },
    ];

    const finalResult = userData.filter((userData)=>{
        return userData.isActive === true && userData.age > 18 
    })

    console.log(JSON.stringify(finalResult)); // JSON.stringify use for convert object in to string so it can help to see result in chrome in object structure with out "[{…}]".
  </script>
